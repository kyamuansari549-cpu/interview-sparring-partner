# LLM provider: "cloud" (default) or "ollama" (local).
# Chain = ordered fallback: first entry is tried first. Default is Groq
# (openai/gpt-oss-120b) primary, Gemini (gemini-3.6-flash) as fallback.
ISP_LLM_PROVIDER=cloud
ISP_LLM_CHAIN=groq,gemini

# Cloud keys — GROQ_API_KEY is required for the default setup (console.groq.com).
# GEMINI_API_KEY powers the fallback (get one free at aistudio.google.com).
GROQ_API_KEY=<redacted>
GEMINI_API_KEY=<redacted>

# Local fallback (only used when ISP_LLM_PROVIDER=ollama)
ISP_OLLAMA_URL=http://localhost:11434
ISP_OLLAMA_MODEL=cyberforge-v2

# Speech-to-text backend: "local" (default) uses the whisper.cpp server at
# WHISPER_URL; "groq" uses Groq's hosted Whisper API instead — that is what
# the Render deploy uses, since no local server can run there.
ISP_TRANSCRIBE=local
WHISPER_URL=http://127.0.0.1:8080
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# edge-tts voice used for the spoken Hinglish questions
TTS_VOICE=hi-IN-SwaraNeural
