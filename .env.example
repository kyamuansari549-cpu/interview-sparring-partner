# LLM provider: "cloud" (default; Gemini primary with gemini-3.6-flash) or "ollama" (local).
# Chain = ordered fallback: first entry is tried first.
ISP_LLM_PROVIDER=cloud
ISP_LLM_CHAIN=gemini,groq

# Cloud keys — GEMINI_API_KEY is required for the default setup (get one free at aistudio.google.com).
# GROQ_API_KEY is optional — Groq is only the automatic fallback.
GEMINI_API_KEY=
GROQ_API_KEY=

# Local fallback (only used when ISP_LLM_PROVIDER=ollama)
ISP_OLLAMA_URL=http://localhost:11434
ISP_OLLAMA_MODEL=cyberforge-v2

# whisper.cpp HTTP server used for speech-to-text
WHISPER_URL=http://127.0.0.1:8080

# edge-tts voice used for the spoken Hinglish questions
TTS_VOICE=hi-IN-SwaraNeural
